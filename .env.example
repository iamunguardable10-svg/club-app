# Nothing here is needed for the local test mode (npm run dev works without a .env file).

# Pilot server (docs/simplify-decisions.md, point 8). The app stays in the
# local test mode unless NEXT_PUBLIC_DATA_BACKEND is "supabase". Sign-in comes
# in Run 10; until then server mode only shows "Nicht angemeldet.".
# URL and key are public by design (publishable key), but belong in
# .env.local or the hosting settings, not in the repository.
NEXT_PUBLIC_DATA_BACKEND=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: address suggestions in the hall form.
NEXT_PUBLIC_GEOAPIFY_API_KEY=
